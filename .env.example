# 复制为 .env.local 后按需修改
# cp .env.example .env.local

# 应用配置
APP_PORT=9001
APP_HOST=http://localhost
# 跨域允许的来源，* 表示不限制；生产建议写成具体域名，如 http://localhost:3000
ALLOWED_ORIGIN=*

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coder_hub
MYSQL_USER=root
MYSQL_PASSWORD=

# 密钥配置（相对项目根目录；留空则使用 src/app/keys）
# 首次运行：npm run keys:generate
KEY_DIR=./src/app/keys
