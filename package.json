{
    "name": "coderhub_ts_cms",
    "version": "1.0.0",
    "description": "",
    "homepage": "https://github.com/Jrea888/coderhub_ts_cms#readme",
    "bugs": {
        "url": "https://github.com/Jrea888/coderhub_ts_cms/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jrea888/coderhub_ts_cms.git"
    },
    "license": "ISC",
    "author": "",
    "type": "commonjs",
    "main": "dist/main.js",
    "scripts": {
        "start": "tsx watch --env-file=.env.local src/main.ts",
        "serve": "node --env-file=.env.local dist/main.js",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint src",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "keys:generate": "node scripts/generate-keys.mjs",
        "keys:rotate": "node scripts/generate-keys.mjs --force",
        "test:api": "node scripts/smoke-test.mjs"
    },
    "dependencies": {
        "@koa/multer": "^4.0.0",
        "@koa/router": "^15.7.1",
        "koa": "^3.3.0",
        "koa-bodyparser": "^4.4.1",
        "multer": "^2.5.0",
        "mysql2": "^3.24.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@types/koa": "^3.0.3",
        "@types/koa-bodyparser": "^4.3.13",
        "@types/koa-router": "^7.4.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "prettier": "^3.6.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=20.6"
    }
}
